{
  "name": "portfolio-contact-server",
  "version": "1.0.0",
  "description": "Small express server to forward contact form messages to Gmail via nodemailer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "deploy": "npx firebase-tools deploy --only hosting,functions",
    "deploy:ci": "npx firebase-tools deploy --only hosting,functions --token $FIREBASE_TOKEN"
  },
  "devDependencies": {
    "firebase-tools": "^11.20.1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "nodemailer": "^6.9.0"
  }
}
